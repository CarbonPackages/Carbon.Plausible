prototype(Carbon.Plausible:Document.DisableTracking) < prototype(Neos.Fusion:Component) {
    title = ${Translation.translate('trackingIsNowDisabled', 'Tracking for {domain} from this browser is now disabled.', [], 'Main', 'Carbon.Plausible')}

    renderer = Neos.Fusion:Http.Message {
        httpResponseHead.headers.Content-Type = 'text/html;charset=UTF-8'
        doctype = '<!DOCTYPE html>'
        content = afx`
            <html>
                <head>
                    <meta charset='UTF-8' />
                    <title>{props.title}</title>
                    <meta name='robots' content='noindex,nofollow' />
                </head>
                <body style='display:flex;align-items:center;min-height:90vh;'>
                    <h1 style='margin:1em auto;max-width:30ch;text-align:center;font-family:system-ui,-apple-system,Segoe UI,Roboto,Cantarell,Noto Sans,sans-serif;'>
                        {props.title}
                    </h1>
                    <script>
                        {StaticResource.content('Carbon.Plausible', 'Public/LocalStorage.js')}
                    </script>
                </body>
            </html>
        `
    }

    @cache {
        mode = 'cached'
        entryIdentifier {
            plausible = 'CarbonPlausibleDisableTracking'
        }
    }
    @exceptionHandler = 'Neos\\Neos\\Fusion\\ExceptionHandlers\\PageHandler'
}
