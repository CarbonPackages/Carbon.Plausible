prototype(Carbon.Plausible:Component.Toggle) < prototype(Neos.Fusion:Component) {
    statusClass = null
    buttonClass = null

    renderer = afx`
        <p style='display:none' data-plausible='status' class={props.statusClass}>
            <span data-plausible='disabled'>
                {Translation.translate('trackingIsDisabled', 'Tracking for {domain} from this browser is disabled.', [], 'Main', 'Carbon.Plausible')}
            </span>
            <span data-plausible='enabled'>
                {Translation.translate('trackingIsEnabled', 'Tracking for {domain} from this browser is enabled.', [], 'Main', 'Carbon.Plausible')}
            </span>
        </p>
        <button style='display:none' data-plausible='button' class={props.buttonClass} type='button'>
            <span data-plausible='disabled'>
                {Translation.translate('enableTracking', 'Enable tracking', [], 'Main', 'Carbon.Plausible')}
            </span>
            <span data-plausible='enabled'>
                {Translation.translate('disableTracking', 'Disable tracking', [], 'Main', 'Carbon.Plausible')}
            </span>
        </button>
        <script>
            {StaticResource.content('Carbon.Plausible', 'Public/Toggle.js')}
        </script>
    `
}
