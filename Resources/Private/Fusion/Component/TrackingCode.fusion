prototype(Carbon.Plausible:Component.TrackingCode) < prototype(Neos.Fusion:Component) {
    // Enable or disable the tracking code.
    enable = ${Configuration.setting('Carbon.Plausible.enable') && !renderingMode.isEdit}

    // If true, no tracking code will be rendered, even if the tracking code is enabled in the settings.
    doNotTrack = ${q(node).is('[instanceof Carbon.Plausible:Mixin.DoNotTrack]') && q(node).property('plausibleDoNotTrack')}

    // Custom events
    hasCustomEventMixin = ${q(node).is('[instanceof Carbon.Plausible:Mixin.CustomEvent]')}
    eventName = ${this.hasCustomEventMixin ? q(node).property('plausibleCustomEventName') : null}
    eventJSON = ${this.eventName ? String.trim(q(node).property('plausibleCustomEventJSON')) : null}

    // The tracking code to use. If not set, the tracking code will be taken from the site settings or the default settings.
    trackingCode = ${q(site).property('plausibleTrackingCode')}

    // The name of the site. Used to get the specdific site settings
    siteName = ${Neos.Site.findBySiteNode(site).name}

    // The definition of the plausible variable
    definePlausibleJavscript = ${Configuration.setting('Carbon.Plausible.definePlausibleJavscript')}

    // Initialization options for the plausible tracking code.
    // See https://plausible.io/docs/script-extensions#plausibleinit-configuration for more information.
    initOptions = Neos.Fusion:DataStructure {
        // Make sure the endpoint is always set, even if no other options are set
        // You also have to take care to set `'` around any string
        endpoint = "'/~pls/api/event'"
    }

    // You can disable the rendering of the inline script tag. This is useful if you want to render the tracking code in a different way, e.g. in a custom template.
    renderInlineScriptTag = true

    // The status code of the current request. Used to determine if a 404 event should be sent.
    statusCode = ${statusCode}

    // Send the event plausible('404') if the status code is between 400 and 499.
    set404Event = true

    @private {
        is404Page = ${props.set404Event && props.statusCode ? (props.statusCode >= 400 && props.statusCode < 500) : false}

        trackingTarget = Carbon.Plausible:Component.TrackingTarget {
            trackingCode = ${props.trackingCode}
            siteName = ${props.siteName}
        }

        initOptions = Neos.Fusion:Loop {
            @glue = ','
            items = ${props.initOptions}
            itemRenderer = ${itemKey + ':' + itemValue}
        }

        inlineJavascript = Neos.Fusion:DataStructure {
            definePlausibleJavscript = ${props.definePlausibleJavscript}
            init = ${'plausible.init({' + private.initOptions + '})'}
            eventFromNode = ${'plausible("' + props.eventName + '"' + (props.eventJSON ? ',' + props.eventJSON : '') + ')'}
            eventFromNode.@if.hasEventName = ${props.eventName}
            set404Event ${private.is404Page ? "document.addEventListener('DOMContentLoaded',()=>{plausible('404')})" : null}
            @process.filter = ${Array.join(Array.filter(value, line => !!line), ';')}
        }
    }

    renderer = Neos.Fusion:Join {
        @if.enabled = ${private.trackingTarget}
        external = Neos.Fusion:Tag {
            tagName = 'script'
            attributes {
                src = '~pls/js/script.js'
                async = true
            }
        }
        inline = Neos.Fusion:Tag {
            @if.set = ${props.renderInlineScriptTag}
            tagName = 'script'
            content = ${private.inlineJavascript}
        }
    }
}
