prototype(Carbon.Plausible:Component.TrackingTarget) < prototype(Neos.Fusion:Component) {
    // Enable or disable the tracking code.
    enable = ${Configuration.setting('Carbon.Plausible.enable') && !renderingMode.isEdit}

    // If true, no tracking code will be rendered, even if the tracking code is enabled in the settings.
    doNotTrack = ${q(node).is('[instanceof Carbon.Plausible:Mixin.DoNotTrack]') && q(node).property('plausibleDoNotTrack')}

    // The tracking code to use. If not set, the tracking code will be taken from the site settings or the default settings.
    trackingCode = ${q(site).property('plausibleTrackingCode')}

    // The name of the site. Used to get the specdific site settings
    siteName = ${Neos.Site.findBySiteNode(site).nodeName}

    @private {
        siteName = ${String.toString(props.siteName)}
        defaultSettings = ${Configuration.setting('Carbon.Plausible.default.trackingCode')}
        siteSettings = ${private.siteName ? Configuration.setting('Carbon.Plausible.sites.' + private.siteName + '.trackingCode') : null}
    }

    renderer = Neos.Fusion:Case {
        @process.split = ${value ? Carbon.Plausible.splitTrackingCode(value) : null}
        disabled {
            condition = ${!props.enable || props.doNotTrack}
            renderer = false
        }
        fromProperties {
            condition = ${props.trackingCode}
            renderer = ${props.trackingCode}
        }
        fromSiteSettings {
            condition = ${private.siteSettings}
            renderer = ${private.siteSettings}
        }
        fromDefaultSettings {
            condition = ${private.defaultSettings}
            renderer = ${private.defaultSettings}
        }
        noTrackingCode {
            condition = true
            renderer = false
        }
    }
}
